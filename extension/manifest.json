{
  "manifest_version": 3,
  "name": "Meet Dashboard Reset",
  "version": "0.1.0",
  "description": "Adds a Meet-styled button that resets the kiosk browser back to the dashboard home screen.",
  "permissions": ["storage", "tabs"],
  "host_permissions": ["*://meet.google.com/*"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["*://meet.google.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_ui": { "page": "options.html", "open_in_tab": true },
  "action": { "default_popup": "options.html", "default_title": "Meet Dashboard Reset settings" }
}
